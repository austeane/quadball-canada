---
import type { InferGetStaticParamsType } from "astro";
import Page from "../_shared/resource-detail.astro";
import { getResourceArticles, type Locale } from "@/utils/sanity";

export async function getStaticPaths() {
  const resources = await getResourceArticles("en");
  return resources.map((resource) => ({ params: { slug: resource.slug } }));
}

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
const { slug } = Astro.params as Params;
const locale: Locale = "en";
---

<Page locale={locale} slug={slug} />
