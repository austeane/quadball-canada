---
import type { Locale } from "../../utils/localization";
import { resolveLocale } from "../../i18n";
import { t } from "../../i18n/ui";
import { getSiteSettings } from "../../utils/sanity";

const props = Astro.props as { locale?: Locale } | undefined;
const locale: Locale = resolveLocale(Astro, props?.locale);
const settings = await getSiteSettings(locale);

const platformNames: Record<string, string> = {
  instagram: "Instagram",
  tiktok: "TikTok",
  youtube: "YouTube",
  facebook: "Facebook",
  discord: "Discord",
  x: "X",
  linkedin: "LinkedIn",
};
const isExternal = (href: string) => /^https?:\/\//.test(href);
const contactPath = locale === "fr" ? "/fr/contact/" : "/contact/";
const charityLabel = locale === "fr" ? "Numéro d'enregistrement d'organisme de bienfaisance" : "Charitable Registration Number";
---
<footer class="site-footer">
  <div class="cols">
    <div>
      <h4>Quadball Canada</h4>
      <p>© {new Date().getFullYear()} Quadball Canada</p>
      {settings.charityNumber && <p>{charityLabel}: {settings.charityNumber}</p>}
      <p><a href={contactPath}>{t(locale, "footer.contact")}</a></p>
    </div>
    {settings.footerColumns.map((column) => (
      <div>
        <h4>{column.title}</h4>
        <ul>
          {column.links.map((link) => (
            <li>
              <a
                href={link.href}
                target={isExternal(link.href) ? "_blank" : undefined}
                rel={isExternal(link.href) ? "noopener" : undefined}
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    {settings.socialLinks.length > 0 && (
      <div>
        <h4>{t(locale, "footer.followUs")}</h4>
        <ul>
          {settings.socialLinks.map((link) => (
            <li><a target="_blank" rel="noopener" href={link.url}>{platformNames[link.platform] ?? link.platform}</a></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</footer>

<style>
  .site-footer {
    padding: 24px 0;
    color: var(--text);
    border-top: 1px solid var(--border);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
  }
  h4 { margin: 0 0 8px; color: var(--text-strong); }
  a { color: var(--brand-primary); text-decoration: none; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin: 6px 0; }
</style>
