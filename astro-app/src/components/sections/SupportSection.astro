---
import EmailLink from "../ui/EmailLink.astro";
import type { HomePageData } from "../../utils/sanity";

interface Props {
  support: NonNullable<HomePageData["support"]>;
  donateUrl?: string | null;
}

const { support, donateUrl } = Astro.props as Props;
const donateHref = support.donateUrl ?? donateUrl;
---
<section class="support">
  {support.heading && <h2>{support.heading}</h2>}
  {support.body && <p>{support.body}</p>}
  <div class="actions">
    {donateHref && support.donateLabel && (
      <a class="btn" href={donateHref} target="_blank" rel="noopener">{support.donateLabel}</a>
    )}
    {support.sponsorshipEmail && (
      <div class="btn-email">
        {support.sponsorshipLabel && <span class="btn-email__label">{support.sponsorshipLabel}:</span>}
        <EmailLink email={support.sponsorshipEmail} class="btn-email__link" />
      </div>
    )}
  </div>
</section>

<style>
  .support { padding: 24px 0; border-top: 1px solid var(--border); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .btn { display: inline-block; background: var(--brand-primary); color: #fff; padding: 10px 16px; border-radius: 4px; text-decoration: none; }
  .btn-email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-secondary, #f8f9fa);
    padding: 8px 14px;
    border-radius: 4px;
    border: 1px solid var(--border);
  }
  .btn-email__label {
    font-weight: 600;
    color: var(--text);
  }
</style>
